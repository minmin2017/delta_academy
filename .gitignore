# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Large reference PDF datasheets (keep lightweight repo; links in _reference/README.md)
_reference/*.pdf

# Ignore local generated video renders
/[Rr]ecordings/
